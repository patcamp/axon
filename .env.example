# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default model.
# Cheapest/fastest: llama-3.1-8b-instant
# Smarter:          llama-3.3-70b-versatile
GROQ_MODEL=llama-3.1-8b-instant

# Used by /api/agent (the VS Code extension backend) — needs a stronger
# model than the main chat's 8B default for reliable code editing.
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# Supabase project (Settings > API in the Supabase dashboard).
# Use the "anon" / "public" key here — never the service_role key,
# it's safe to expose client-side because access control is via RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here
