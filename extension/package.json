{
  "name": "axon-assistant",
  "displayName": "Axon Assistant",
  "description": "Chat with your codebase and apply edits, backed by your Axon account.",
  "version": "0.1.0",
  "publisher": "axon",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/axon"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "axon.openAssistant",
        "title": "Axon: Open Assistant"
      }
    ],
    "configuration": {
      "title": "Axon",
      "properties": {
        "axon.backendUrl": {
          "type": "string",
          "default": "",
          "description": "The origin of your Axon deployment (e.g. https://your-app.vercel.app)."
        },
        "axon.token": {
          "type": "string",
          "default": "",
          "description": "Personal access token generated on the /code page of your Axon deployment."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && mkdir -p out/webview && cp src/webview/main.js src/webview/styles.css out/webview/",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "diff": "^5.2.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}
